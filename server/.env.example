# Porta do servidor Express
PORT=3333

# Chave pública da API DataJud (fornecida pelo CNJ na wiki oficial:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/ — pode ser renovada a qualquer momento)
DATAJUD_TOKEN=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# URL base da API pública do DataJud
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Timeout (ms) das chamadas ao DataJud
DATAJUD_TIMEOUT_MS=15000

# Tentativas em 429/502/503/504/timeout (1 = sem retry)
DATAJUD_MAX_RETRIES=3

# TTL (s) do cache em memória dos resultados
CACHE_TTL_SECONDS=300

# TTL (s) do cache de processos não encontrados
CACHE_NEGATIVE_TTL_SECONDS=60

# Limite de entradas do cache
CACHE_MAX_ENTRIES=200

# Rate limit por IP
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Origens permitidas no CORS (separar por vírgula)
CORS_ORIGIN=http://localhost:5173

# Nível de log do pino (debug | info | warn | error | silent)
LOG_LEVEL=info

# Caminho do frontend compilado servido em produção
CLIENT_DIST=client/dist